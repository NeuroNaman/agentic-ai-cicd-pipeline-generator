# GitHub Actions — Python CI/CD Template
#
# Variables available:
#   {{ python_version }}
#   {{ package_manager }}  (pip, poetry, pipenv)
#   {{ test_command }}
#   {{ lint_command }}
#   {{ has_docker }}
#   {{ docker_image_name }}
#   {{ has_deploy }}
#   {{ deploy_target }}

name: CI/CD Pipeline
on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

env:
  PYTHON_VERSION: '{{ python_version | default("3.12") }}'
{% if has_docker %}
  IMAGE_NAME: {{ docker_image_name | default("${{ github.event.repository.name }}") }}
{% endif %}

jobs:
  ci:
    name: CI — Lint, Test, Build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python ${{ '{{' }} env.PYTHON_VERSION {{ '}}' }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ '{{' }} env.PYTHON_VERSION {{ '}}' }}

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ '{{' }} runner.os {{ '}}' }}-pip-${{ '{{' }} hashFiles('**/requirements*.txt') {{ '}}' }}
          restore-keys: |
            ${{ '{{' }} runner.os {{ '}}' }}-pip-

{% if package_manager == "poetry" %}
      - name: Install Poetry
        run: pip install poetry

      - name: Install dependencies
        run: poetry install

      - name: Run linter
        run: poetry run {{ lint_command | default("ruff check .") }}

      - name: Run tests
        run: poetry run {{ test_command | default("pytest --cov") }}
{% elif package_manager == "pipenv" %}
      - name: Install Pipenv
        run: pip install pipenv

      - name: Install dependencies
        run: pipenv install --dev

      - name: Run linter
        run: pipenv run {{ lint_command | default("ruff check .") }}

      - name: Run tests
        run: pipenv run {{ test_command | default("pytest --cov") }}
{% else %}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          {% if has_dev_requirements %}
          pip install -r requirements-dev.txt
          {% endif %}

      - name: Run linter
        run: {{ lint_command | default("ruff check .") }}

      - name: Run tests
        run: {{ test_command | default("pytest --cov") }}
{% endif %}

{% if has_docker %}
  docker:
    name: Build & Push Docker Image
    runs-on: ubuntu-latest
    needs: [ci]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ '{{' }} secrets.DOCKER_USERNAME {{ '}}' }}
          password: ${{ '{{' }} secrets.DOCKER_PASSWORD {{ '}}' }}

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: |
            ${{ '{{' }} secrets.DOCKER_USERNAME {{ '}}' }}/${{ '{{' }} env.IMAGE_NAME {{ '}}' }}:${{ '{{' }} github.sha {{ '}}' }}
            ${{ '{{' }} secrets.DOCKER_USERNAME {{ '}}' }}/${{ '{{' }} env.IMAGE_NAME {{ '}}' }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max
{% endif %}

{% if has_deploy %}
  deploy:
    name: Deploy to {{ deploy_target | default("Production") }}
    runs-on: ubuntu-latest
    needs: [ci{% if has_docker %}, docker{% endif %}]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    environment: production
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # Add deployment steps here based on deploy_target
{% endif %}
