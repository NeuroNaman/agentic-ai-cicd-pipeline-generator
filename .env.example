# Agentic CI/CD Engineer
# Environment variables configuration

# --- LLM ---
CICD_AGENT_LLM_PROVIDER=openai
CICD_AGENT_LLM_MODEL=gpt-4o
CICD_AGENT_LLM_FALLBACK_MODEL=claude-3-5-sonnet-20241022
CICD_AGENT_LLM_TEMPERATURE=0.1
CICD_AGENT_GROQ_API_KEY=your-groq-api-key-here
# --- API Keys (replace with your actual keys) ---
CICD_AGENT_OPENAI_API_KEY=your-openai-api-key-here
CICD_AGENT_ANTHROPIC_API_KEY=your-anthropic-api-key-here
CICD_AGENT_GROQ_API_KEY=your-groq-api-key-here
CICD_AGENT_GOOGLE_API_KEY=your-google-ai-studio-api-key-here
CICD_AGENT_GITHUB_TOKEN=your-github-token-here

# --- Database ---
CICD_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cicd_agent
CICD_AGENT_REDIS_URL=redis://localhost:6379/0

# --- Sandbox ---
CICD_AGENT_SANDBOX_ENABLED=true
CICD_AGENT_SANDBOX_TIMEOUT_SECONDS=300

# --- Pipeline Defaults ---
CICD_AGENT_DEFAULT_CICD_PLATFORM=github_actions
CICD_AGENT_REQUIRE_HUMAN_APPROVAL=true
CICD_AGENT_MAX_SELF_HEALING_RETRIES=3

# --- Logging ---
CICD_AGENT_LOG_LEVEL=INFO
CICD_AGENT_DEBUG=false
